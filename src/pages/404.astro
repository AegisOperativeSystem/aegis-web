---
import Base from "../layouts/Base.astro"

const description = "That page is not part of the Aegis OS website."
---

<Base title="Page not found" description={description} path="/404" robots="noindex, follow">
  <section class="mx-auto max-w-6xl px-6 py-24">
    <p class="text-sm font-semibold text-accent">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">This page is not on the site</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">The address does not match a guide or a product page. The wiki and the download page are the two most useful places to continue.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/wiki">Wiki</a>
      <a class="btn btn-secondary" href="/download">Download</a>
    </div>
  </section>
</Base>
