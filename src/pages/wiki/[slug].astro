---
import Base from "../../layouts/Base.astro"
import { getCollection, render } from "astro:content"
import { breadcrumbLd } from "../../lib/jsonld"

export const getStaticPaths = async () => {
  const articles = await getCollection("wiki")
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }))
}

const { article } = Astro.props
const { Content, headings } = await render(article)
const articles = (await getCollection("wiki")).sort((a, b) => a.data.order - b.data.order)
const index = articles.findIndex((entry) => entry.id === article.id)
const previous = articles[index - 1]
const next = articles[index + 1]
const site = Astro.site ?? new URL("https://aegisos.vercel.app")
const path = `/wiki/${article.id}`
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)

const jsonLd = [
  breadcrumbLd(site, [
    { name: "Home", path: "/" },
    { name: "Wiki", path: "/wiki" },
    { name: article.data.title, path },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: article.data.title,
    description: article.data.description,
    dateModified: article.data.updated.toISOString(),
    datePublished: article.data.updated.toISOString(),
    inLanguage: "en",
    mainEntityOfPage: new URL(path, site).href,
    author: { "@type": "Organization", name: "Aegis OS" },
  },
]
---

<Base
  title={article.data.title}
  description={article.data.description}
  path={path}
  ogType="article"
  published={article.data.updated}
  updated={article.data.updated}
  jsonLd={jsonLd}
>
  <article class="mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <div>
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a class="hover:text-fg" href="/wiki">Wiki</a>
        <span aria-hidden="true"> / </span>
        <span>{article.data.section}</span>
      </nav>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight">{article.data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">{article.data.description}</p>
      <p class="mt-3 text-sm text-muted">
        Updated {article.data.updated.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}
      </p>
      <div class="prose mt-10">
        <Content />
      </div>
      <nav class="mt-12 grid gap-4 border-t border-line pt-6 sm:grid-cols-2" aria-label="Adjacent articles">
        {
          previous && (
            <a class="rounded-2xl border border-line p-4 hover:bg-elev" href={`/wiki/${previous.id}`}>
              <span class="text-sm text-muted">Previous</span>
              <span class="mt-1 block font-semibold">{previous.data.title}</span>
            </a>
          )
        }
        {
          next && (
            <a class="rounded-2xl border border-line p-4 hover:bg-elev sm:text-right" href={`/wiki/${next.id}`}>
              <span class="text-sm text-muted">Next</span>
              <span class="mt-1 block font-semibold">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
    {
      toc.length > 0 && (
        <aside class="hidden lg:block">
          <nav class="sticky top-24" aria-label="On this page">
            <p class="text-sm font-semibold">On this page</p>
            <ul class="mt-3 grid gap-2">
              {toc.map((heading) => (
                <li class:list={[{ "pl-4": heading.depth === 3 }]}>
                  <a class="text-sm text-muted hover:text-fg" href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </article>
</Base>
