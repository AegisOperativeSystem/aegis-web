---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
import { breadcrumbLd } from "../lib/jsonld"
import { githubOrg } from "../data/site"

const site = Astro.site ?? new URL("https://aegisos.vercel.app")
const description = "Aegis OS is a free Arch-based operating system maintained in the AegisOperativeSystem organization."
---

<Base
  title="About"
  description={description}
  path="/about"
  jsonLd={[breadcrumbLd(site, [{ name: "Home", path: "/" }, { name: "About", path: "/about" }])]}
>
  <PageIntro
    eyebrow="About"
    title="A lightweight Arch system with its own desktop"
    lede="Aegis OS is built in public by the AegisOperativeSystem organization. The userspace is GPL-3.0-only. The kernel package is GPL-2.0-only."
  />
  <div class="mx-auto grid max-w-6xl gap-4 px-6 py-12 md:grid-cols-3">
    <article class="rounded-2xl border border-line p-6">
      <h2 class="text-xl font-semibold">Base</h2>
      <p class="mt-3 text-muted">Arch Linux, systemd, and pacman. The image adds a session, an installer, and a package repository on top of that base.</p>
    </article>
    <article class="rounded-2xl border border-line p-6">
      <h2 class="text-xl font-semibold">Desktop</h2>
      <p class="mt-3 text-muted">GTK4 and labwc. The panel is small on purpose, and the theme uses square corners and a fixed palette.</p>
    </article>
    <article class="rounded-2xl border border-line p-6">
      <h2 class="text-xl font-semibold">Source</h2>
      <p class="mt-3 text-muted">Work happens in three public repositories. Pull requests are linted. Version tags publish the kernel, the package database, and the ISO.</p>
    </article>
  </div>
  <p class="mx-auto max-w-6xl px-6 pb-16">
    <a class="font-semibold text-accent hover:underline" href={githubOrg}>github.com/AegisOperativeSystem</a>
  </p>
</Base>
