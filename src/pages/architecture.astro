---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
import { breadcrumbLd } from "../lib/jsonld"
import { repos } from "../data/site"

const site = Astro.site ?? new URL("https://aegisos.vercel.app")
const description = "Aegis OS is three repositories: the live image and desktop, the kernel package, and the pacman database."
---

<Base
  title="Architecture"
  description={description}
  path="/architecture"
  jsonLd={[breadcrumbLd(site, [{ name: "Home", path: "/" }, { name: "Architecture", path: "/architecture" }])]}
>
  <PageIntro
    eyebrow="Architecture"
    title="Three repositories, three artifacts"
    lede="aegis-os builds the ISO. aegis-kernel builds linux-aegis. aegis-pkgs builds the pacman database and indexes the kernel into it."
  />
  <section class="mx-auto grid max-w-6xl gap-4 px-6 py-12 lg:grid-cols-3">
    {repos.map((repo) => (
      <a class="rounded-2xl border border-line p-6 hover:border-accent" href={repo.href}>
        <h2 class="font-mono text-sm text-accent">{repo.name}</h2>
        <p class="mt-3 text-lg font-semibold">{repo.role}</p>
      </a>
    ))}
  </section>
  <section class="mx-auto max-w-6xl px-6 pb-16">
    <div class="grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-line p-6">
        <h2 class="text-xl font-semibold">Boot</h2>
        <p class="mt-3 text-muted">The ISO profile uses mkarchiso with the UEFI systemd-boot mode. The install directory name is aegis. The loader waits five seconds.</p>
      </article>
      <article class="rounded-2xl border border-line p-6">
        <h2 class="text-xl font-semibold">Live session</h2>
        <p class="mt-3 text-muted">aegis-live-setup creates the user live. greetd starts the session. A polkit rule lets that user run the installer.</p>
      </article>
      <article class="rounded-2xl border border-line p-6">
        <h2 class="text-xl font-semibold">Installer core</h2>
        <p class="mt-3 text-muted">aegis-common builds the action list and is covered by unit tests. The GTK interface collects the disk, account, and filesystem, then runs that list.</p>
      </article>
      <article class="rounded-2xl border border-line p-6">
        <h2 class="text-xl font-semibold">Continuous integration</h2>
        <p class="mt-3 text-muted">Pull requests lint and test the shared library. Version tags compile the kernel, publish packages, and upload the ISO to GitHub Releases.</p>
      </article>
    </div>
    <p class="mt-8">
      <a class="font-semibold text-accent hover:underline" href="https://github.com/AegisOperativeSystem/aegis-os/blob/main/ARCHITECTURE.md">Architecture notes in aegis-os</a>
    </p>
  </section>
</Base>
