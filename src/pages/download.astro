---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
import { breadcrumbLd } from "../lib/jsonld"
import { formatBytes, formatReleaseDate, loadIsoReleases, type IsoRelease } from "../lib/releases"
import { isoReleasesPage } from "../data/site"
import { firmwareFor } from "../lib/vbox"

let releases: IsoRelease[] = []
let loadError = false
try {
  releases = await loadIsoReleases()
} catch {
  loadError = true
}

const site = Astro.site ?? new URL("https://aegisos.vercel.app")
const description = "Download Aegis OS ISO images and a ready VirtualBox machine for x86_64, with SHA-256 checksums."
const jsonLd = [
  breadcrumbLd(site, [
    { name: "Home", path: "/" },
    { name: "Download", path: "/download" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Aegis OS",
    applicationCategory: "OperatingSystem",
    operatingSystem: "Linux",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    downloadUrl: releases[0]?.url ?? isoReleasesPage,
    description,
  },
]
---

<Base title="Download the ISO" description={description} path="/download" jsonLd={jsonLd}>
  <PageIntro
    eyebrow="Download"
    title="Bootable ISO images"
    lede="Download the image, or a VirtualBox machine that already has the right disk, memory, and boot order. Put the ISO next to the machine file and start it."
  />

  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)]">
    <div id="iso-releases" data-filled={releases.length > 0 ? "true" : "false"}>
      {
        loadError && (
          <div class="rounded-2xl border border-line bg-elev p-6">
            <h2 class="text-2xl font-semibold tracking-tight">Release list unavailable</h2>
            <p class="mt-3 text-muted">The GitHub release API did not respond while this page was built. The link below opens the same releases directly.</p>
            <a class="btn btn-secondary mt-6" href={isoReleasesPage}>Open GitHub releases</a>
          </div>
        )
      }
      {
        !loadError && releases.length === 0 && (
          <div class="rounded-2xl border border-line bg-elev p-6">
            <h2 class="text-2xl font-semibold tracking-tight">No image published yet</h2>
            <p class="mt-3 max-w-2xl text-muted">Aegis OS uploads a bootable ISO when a version tag is pushed from aegis-os. This page lists every .iso asset on that GitHub release list.</p>
            <a class="btn btn-secondary mt-6" href={isoReleasesPage}>Open GitHub releases</a>
          </div>
        )
      }
      {
        releases[0] && (
          <article class="rounded-2xl border border-line bg-elev p-6">
            <p class="text-sm font-semibold text-accent">Latest image</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">{releases[0].name}</h2>
            <p class="mt-2 text-sm text-muted">
              {releases[0].version} · {formatReleaseDate(releases[0].published)} · {formatBytes(releases[0].size)}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a class="btn btn-primary" href={releases[0].url}>Download ISO</a>
              <button type="button" class="btn btn-secondary" data-vbox={releases[0].name} data-firmware={firmwareFor(releases[0].version)}>VirtualBox machine</button>
            </div>
            {
              releases[0].digest && (
                <div class="mt-6">
                  <p class="text-sm font-semibold">SHA-256</p>
                  <code class="mt-2 block overflow-x-auto font-mono text-xs text-muted">{releases[0].digest}</code>
                  <button type="button" class="btn btn-secondary mt-4" data-copy={releases[0].digest}>Copy checksum</button>
                </div>
              )
            }
          </article>
        )
      }
      {
        releases.length > 1 && (
          <section class="mt-8">
            <h2 class="text-xl font-semibold">Earlier images</h2>
            <div class="mt-4 grid gap-4">
              {releases.slice(1).map((release) => (
                <article class="rounded-2xl border border-line bg-elev p-6">
                  <p class="text-sm font-semibold text-accent">{release.version}</p>
                  <h2 class="mt-2 text-2xl font-semibold tracking-tight">{release.name}</h2>
                  <p class="mt-2 text-sm text-muted">
                    {release.version} · {formatReleaseDate(release.published)} · {formatBytes(release.size)}
                  </p>
                  <a class="btn btn-primary mt-6" href={release.url}>Download</a>
                  {
                    release.digest && (
                      <div class="mt-6">
                        <p class="text-sm font-semibold">SHA-256</p>
                        <code class="mt-2 block overflow-x-auto font-mono text-xs text-muted">{release.digest}</code>
                        <button type="button" class="btn btn-secondary mt-4" data-copy={release.digest}>Copy checksum</button>
                      </div>
                    )
                  }
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside id="virtualbox" class="rounded-2xl border border-line bg-elev/80 p-6 shadow-[0_24px_50px_-36px_rgba(0,0,0,0.85)]">
      <h2 class="text-xl font-semibold">VirtualBox</h2>
      <ol class="mt-4 grid list-decimal gap-3 pl-5 text-sm leading-6 text-muted">
        <li>Download the ISO and the VirtualBox machine.</li>
        <li>Unzip the machine and put the ISO in that same folder. Keep the ISO file name.</li>
        <li>Open Aegis OS.vbox. Images before 1.0.4 start with EFI on. From 1.0.4, EFI stays off. The 16 GiB disk is empty until you install.</li>
      </ol>
      <p class="mt-4 text-sm text-muted">Use version 1.0.4 or newer. Earlier images boot only with EFI enabled.</p>
      <h2 class="mt-8 text-xl font-semibold">Before you write a USB drive</h2>
      <ul class="mt-4 grid gap-3 text-sm leading-6 text-muted">
        <li>x86_64 PC, BIOS or UEFI</li>
        <li>Secure Boot disabled</li>
        <li>A whole disk of at least 8 GiB for installation</li>
        <li>A network connection during pacstrap</li>
      </ul>
      <a class="mt-6 inline-flex min-h-11 items-center font-semibold text-accent hover:underline" href="/wiki/write-the-image">How to write and verify the image</a>
    </aside>
  </div>

  <section class="mx-auto grid max-w-6xl gap-6 px-6 pb-16 lg:grid-cols-2">
    <article class="rounded-2xl border border-line p-6">
      <h2 class="text-2xl font-semibold tracking-tight">Verify</h2>
      <p class="mt-3 text-muted">Compare the file with the SHA-256 on the release card.</p>
      <pre class="mt-4 overflow-x-auto rounded-xl border border-line bg-elev p-4 font-mono text-sm"><code>sha256sum aegis-*.iso</code></pre>
    </article>
    <article class="rounded-2xl border border-danger/40 bg-danger/10 p-6" role="note">
      <h2 class="text-2xl font-semibold tracking-tight">Write</h2>
      <p class="mt-3 text-muted">`dd` replaces the device you name. Confirm it with `lsblk` and pass the whole disk.</p>
      <pre class="mt-4 overflow-x-auto rounded-xl border border-line bg-elev p-4 font-mono text-sm"><code>sudo dd if=aegis-*.iso of=/dev/sdX bs=4M conv=fsync status=progress</code></pre>
    </article>
  </section>
</Base>

<script>
  import { loadIsoReleases } from "../lib/releases"
  import { downloadVirtualBoxZip } from "../lib/vbox"
  import { bindCopy, paintReleases } from "../scripts/paint-releases"

  const bindMachine = (scope: ParentNode) => {
    scope.querySelectorAll("[data-vbox]").forEach((node) => {
      if (!(node instanceof HTMLButtonElement) || node.dataset.bound === "true") return
      node.dataset.bound = "true"
      node.addEventListener("click", () => {
        const isoName = node.dataset.vbox
        const firmware = node.dataset.firmware === "EFI" ? "EFI" : "BIOS"
        if (!isoName) return
        downloadVirtualBoxZip(isoName, firmware)
      })
    })
  }

  bindMachine(document)
  const root = document.querySelector("#iso-releases")
  if (root instanceof HTMLElement) {
    bindCopy(root)
    try {
      const live = await loadIsoReleases()
      const filled = root.dataset.filled === "true"
      if (live.length > 0 || !filled) {
        paintReleases(root, live)
        bindMachine(root)
      }
    } catch {
      // Keep the list rendered when this page was built.
    }
  }
</script>
