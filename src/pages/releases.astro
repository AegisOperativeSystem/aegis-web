---
import Base from "../layouts/Base.astro"
import PageIntro from "../components/PageIntro.astro"
import { breadcrumbLd } from "../lib/jsonld"
import { isoReleasesPage, packageRepo } from "../data/site"

const site = Astro.site ?? new URL("https://aegisos.vercel.app")
const description = "How Aegis OS publishes kernel packages, the pacman database, and bootable ISO images."
---

<Base
  title="Releases"
  description={description}
  path="/releases"
  jsonLd={[breadcrumbLd(site, [{ name: "Home", path: "/" }, { name: "Releases", path: "/releases" }])]}
>
  <PageIntro
    eyebrow="Releases"
    title="Tags publish artifacts"
    lede="The main branch is the source of the next image. A version tag is what uploads a kernel package or an ISO. The pacman database uses one rolling release."
  />
  <ol class="mx-auto grid max-w-6xl gap-4 px-6 py-12">
    <li class="rounded-2xl border border-line p-6">
      <h2 class="text-xl font-semibold">1. Kernel</h2>
      <p class="mt-2 text-muted">A tag on aegis-kernel compiles linux-aegis, signs it when the key is configured, and uploads the package. The default profile is balanced.</p>
    </li>
    <li class="rounded-2xl border border-line p-6">
      <h2 class="text-xl font-semibold">2. Package database</h2>
      <p class="mt-2 text-muted">aegis-pkgs publishes the database on the release tag x86_64. Pacman reads aegis.db from that tag. Kernel builds can ask this repository to index the new package.</p>
      <p class="mt-3 break-all font-mono text-xs text-muted">{packageRepo}</p>
    </li>
    <li class="rounded-2xl border border-line p-6">
      <h2 class="text-xl font-semibold">3. ISO</h2>
      <p class="mt-2 text-muted">A tag on aegis-os builds the live image in an Arch container and uploads the .iso to GitHub Releases. The download page lists those files.</p>
      <p class="mt-4"><a class="font-semibold text-accent hover:underline" href="/download">Download page</a></p>
    </li>
  </ol>
  <p class="mx-auto max-w-6xl px-6 pb-16">
    <a class="font-semibold text-accent hover:underline" href={isoReleasesPage}>ISO releases on GitHub</a>
  </p>
</Base>
