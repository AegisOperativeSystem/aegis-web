---
interface Props {
  eyebrow: string
  title: string
  lede: string
}

const { eyebrow, title, lede } = Astro.props
---

<header class="mx-auto max-w-6xl px-6 pt-16">
  <p class="text-sm font-semibold text-accent">{eyebrow}</p>
  <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl sm:leading-[1.15]">{title}</h1>
  <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{lede}</p>
</header>
