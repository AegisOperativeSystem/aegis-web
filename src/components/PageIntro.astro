---
interface Props {
  eyebrow: string
  title: string
  lede: string
}

const { eyebrow, title, lede } = Astro.props
---

<header class="mx-auto max-w-6xl px-6 pt-16">
  <p class="text-sm font-semibold tracking-[0.16em] text-accent uppercase">{eyebrow}</p>
  <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-[-0.04em] sm:text-6xl sm:leading-[1.05]">{title}</h1>
  <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">{lede}</p>
</header>
