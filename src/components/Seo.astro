---
import { jsonLdScript } from "../lib/jsonld"

interface Props {
  title: string
  description: string
  path: string
  ogType?: "website" | "article"
  robots?: string
  published?: Date
  updated?: Date
  jsonLd?: unknown[]
}

const {
  title,
  description,
  path,
  ogType = "website",
  robots = "index, follow, max-image-preview:large",
  published,
  updated,
  jsonLd = [],
} = Astro.props

const canonical = new URL(path, Astro.site)
const image = new URL("/og.png", Astro.site)
const fullTitle = title.includes("Aegis OS") ? title : `${title} · Aegis OS`
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical.href} />
<link rel="alternate" hreflang="en" href={canonical.href} />
<link rel="alternate" hreflang="x-default" href={canonical.href} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Aegis OS, ultra-lightweight Arch Linux" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Aegis OS" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
<meta name="twitter:image:alt" content="Aegis OS, ultra-lightweight Arch Linux" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title="Aegis OS wiki" href={new URL("/rss.xml", Astro.site).href} />
{
  jsonLd.map((entry) => (
    <script type="application/ld+json" is:inline set:html={jsonLdScript(entry)} />
  ))
}
