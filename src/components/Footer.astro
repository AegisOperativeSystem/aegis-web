---
import Logo from "./Logo.astro"
import { footerDocs, repos } from "../data/site"
---

<footer class="mt-16 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <a href="/" class="inline-flex min-h-11 items-center gap-2" aria-label="Aegis OS home">
        <Logo class="size-7 text-accent" />
        <span class="font-semibold">Aegis OS</span>
      </a>
      <p class="mt-3 max-w-xs text-sm leading-6 text-muted">
        Ultra-lightweight Arch Linux for x86_64 UEFI PCs. GPL-3.0-only userspace. GPL-2.0-only kernel.
      </p>
    </div>
    <nav aria-label="Documentation">
      <h2 class="text-sm font-semibold">Documentation</h2>
      <ul class="mt-3 grid gap-1">
        {
          footerDocs.map((item) => (
            <li>
              <a class="inline-flex min-h-11 items-center text-sm text-muted hover:text-fg" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Source repositories">
      <h2 class="text-sm font-semibold">Source</h2>
      <ul class="mt-3 grid gap-1">
        {
          repos.map((repo) => (
            <li>
              <a class="inline-flex min-h-11 items-center text-sm text-muted hover:text-fg" href={repo.href}>
                {repo.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto flex max-w-6xl flex-wrap gap-x-4 gap-y-2 px-6 py-4 text-sm text-muted">
      <span>© 2026 Aegis OS contributors</span>
      <a class="hover:text-fg" href="https://www.gnu.org/licenses/gpl-3.0.txt">GPL-3.0-only</a>
      <a class="hover:text-fg" href="/rss.xml">Wiki RSS</a>
    </p>
  </div>
</footer>
